{
  "name": "edemand",
  "version": "1.0.0",
  "description": "DES428 capstone — Bangkok Homeservice (eDemand): a Next.js monolith plus two extracted Express services with their own PostgreSQL databases, Keycloak RS256 identity, RabbitMQ events, OpenTelemetry and Pact contracts",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "imports": {
    "#lib/*": "./lib/*"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "test": "node --test",
    "test:unit": "node --test test/*.test.js",
    "test:pact": "node --test test/pact"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^1.30.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.2",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-trace-node": "^1.30.1",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "amqplib": "^0.10.5",
    "bcryptjs": "2.4.3",
    "better-sqlite3": "11.10.0",
    "jsonwebtoken": "9.0.2",
    "next": "14.2.35",
    "pino": "9.4.0",
    "prom-client": "^15.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "uuid": "9.0.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@pact-foundation/pact": "^13.2.0"
  }
}

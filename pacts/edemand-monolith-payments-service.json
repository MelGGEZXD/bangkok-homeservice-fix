{
  "consumer": {
    "name": "edemand-monolith"
  },
  "interactions": [
    {
      "description": "a request for the provider's wallet",
      "providerStates": [
        {
          "name": "provider 1 has a wallet with one payout"
        }
      ],
      "request": {
        "headers": {
          "authorization": "Bearer test-token",
          "x-request-id": "req-2"
        },
        "matchingRules": {
          "header": {
            "authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "x-request-id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "method": "GET",
        "path": "/api/provider/wallet"
      },
      "response": {
        "body": {
          "balance_cents": 109140,
          "commission_owed_cents": 19260,
          "provider_id": 1,
          "transactions": [
            {
              "amount_cents": 109140,
              "created_at": "2026-01-01T00:00:00.000Z",
              "gateway_ref": "PI-8001",
              "id": 1,
              "kind": "payout_credit",
              "method": "gateway",
              "order_id": 8001,
              "status": "succeeded"
            }
          ]
        },
        "headers": {
          "Content-Type": "application/json",
          "content-type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.balance_cents": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.commission_owed_cents": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.provider_id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.transactions[0].amount_cents": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.transactions[0].created_at": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.transactions[0].gateway_ref": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.transactions[0].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.transactions[0].kind": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.transactions[0].method": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.transactions[0].order_id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.transactions[0].status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "an idempotent create-intent command",
      "providerStates": [
        {
          "name": "booking 8001 is awaiting a gateway payment"
        }
      ],
      "request": {
        "body": {
          "amount_cents": 128400,
          "gateway_ref": "PI-8001",
          "order_id": 8001
        },
        "headers": {
          "Content-Type": "application/json",
          "idempotency-key": "payment-intent:8001",
          "x-internal-key": "test-internal-key",
          "x-request-id": "req-1"
        },
        "matchingRules": {
          "body": {
            "$.amount_cents": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.gateway_ref": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.order_id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          },
          "header": {
            "idempotency-key": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "payment-intent:\\d+"
                }
              ]
            },
            "x-internal-key": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "x-request-id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/internal/payment-intents"
      },
      "response": {
        "body": {
          "intent": {
            "amount_cents": 128400,
            "gateway_ref": "PI-8001",
            "id": 1,
            "order_id": 8001,
            "status": "requires_payment"
          }
        },
        "headers": {
          "Content-Type": "application/json",
          "content-type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.intent.amount_cents": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.intent.gateway_ref": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.intent.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.intent.order_id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.intent.status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {},
          "status": {}
        },
        "status": 201
      }
    },

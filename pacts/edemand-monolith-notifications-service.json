{
  "consumer": {
    "name": "edemand-monolith"
  },
  "interactions": [
    {
      "description": "a request for the caller's notifications",
      "providerStates": [
        {
          "name": "customer 1 has at least one notification"
        }
      ],
      "request": {
        "headers": {
          "authorization": "Bearer test-token",
          "x-request-id": "req-1"
        },
        "matchingRules": {
          "header": {
            "authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "x-request-id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "method": "GET",
        "path": "/api/notifications"
      },
      "response": {
        "body": [
          {
            "body": "You can now accept jobs.",
            "created_at": "2026-01-01T00:00:00Z",
            "id": 1,
            "order_id": 8001,
            "read_at": null,
            "title": "You are approved",
            "type": "provider_approved"
          }
        ],
        "headers": {
          "Content-Type": "application/json",
          "content-type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$[*].body": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].created_at": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$[*].order_id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$[*].title": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {},
          "status": {}
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "13.2.0"
    },
    "pactRust": {
      "ffi": "0.4.22",
      "models": "1.2.3"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "notifications-service"
  }
}
# Copy to .env for local/compose runs and replace these demo values.
# Area B: Keycloak issues every production token. The monolith and the notifications service verify
# those tokens against the realm JWKS; they do not share a signing secret. JWT_SECRET only remains
# for the node:test suite / local dev without Keycloak, where KEYCLOAK_URL is unset.
JWT_SECRET=change-me-to-a-long-random-string
INTERNAL_API_KEY=change-me-to-a-long-random-string

# Keycloak (the realm import in keycloak/realm-edemand.json creates the demo users and clients).
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Point this at a published hostname in any non-local deployment. Tokens carry this issuer.
KEYCLOAK_ISSUER=http://localhost:8081/realms/edemand
KEYCLOAK_AUDIENCE=edemand-api

# Notifications service PostgreSQL (used by compose; values shown are the demo defaults)
POSTGRES_USER=user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=notifications_db

# Payments service (local Compose defaults may be overridden here).
PAYMENTS_DB_PASSWORD=change-me
PAYMENTS_CLIENT_SECRET=change-me-to-a-different-random-string

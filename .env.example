# Copy to `.env` for local/compose runs and replace the demo values before any real deployment.
#
# Docker Compose reads this file for interpolation. The committed defaults are deliberately
# demo-only; `docs/dossier.md` §4.6 lists what a production deployment must change.

# ---------------------------------------------------------------------------------------------
# Core secrets
# ---------------------------------------------------------------------------------------------
# Used only by the isolated `node:test` suite / local dev without Keycloak. Production tokens are
# always RS256 tokens signed by Keycloak and verified through the realm JWKS.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Shared secret for monolith -> extracted-service internal calls. Never sent to browsers; nginx
# returns 404 for /api/internal, /internal and /metrics.
INTERNAL_API_KEY=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------------------------
# Keycloak (Area B): the only production token issuer
# ---------------------------------------------------------------------------------------------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_REALM=edemand
# The login/registration client. It carries the local_id and role mappers and the edemand-api
# audience mapper.
KEYCLOAK_CLIENT_ID=edemand-web
# The issuer written into every token. Compose pins this to the published hostname so the same token
# verifies whether it was requested from the host or from inside the network.
KEYCLOAK_ISSUER=http://localhost:8081/realms/edemand
KEYCLOAK_AUDIENCE=edemand-api
# Internal URL used by the containers to fetch the JWKS. Compose sets this to
# http://keycloak:8080, so it is commented out here: a `.env` file is also read by `npm run dev`,
# where the service name `keycloak` does not resolve. For local dev, uncomment and use localhost.
# KEYCLOAK_URL=http://localhost:8081

# ---------------------------------------------------------------------------------------------
# Notifications service PostgreSQL (Area A)
# ---------------------------------------------------------------------------------------------
POSTGRES_USER=user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=notifications_db

# ---------------------------------------------------------------------------------------------
# Payments & Wallet PostgreSQL (Area A, second extraction)
# ---------------------------------------------------------------------------------------------
# Deliberately a different database from notifications: each service owns its own schema and never
# reads the other's tables.
PAYMENTS_DB=payments_db

# Shared secret the mock payment gateway signs callbacks with. The payments service checks it.
WEBHOOK_SECRET=edemand-webhook-secret

# ---------------------------------------------------------------------------------------------
# RabbitMQ (Area C)
# ---------------------------------------------------------------------------------------------
RABBITMQ_USER=edemand
RABBITMQ_PASSWORD=change-me
RABBITMQ_EXCHANGE=edemand.events
NOTIFICATIONS_QUEUE=edemand.notifications
SAGA_QUEUE=edemand.sagas
# Only needed for local `npm run dev`; compose builds it from the values above.
# RABBITMQ_URL=amqp://edemand:edemand-demo-pass@localhost:5672
# RABBITMQ_PREFETCH=20

# ---------------------------------------------------------------------------------------------
# Service locations and timeouts
# ---------------------------------------------------------------------------------------------
# Local `npm run dev` defaults. Compose uses the service DNS names instead.
# NOTIFICATIONS_SERVICE_URL=http://localhost:3001
# PAYMENTS_SERVICE_URL=http://localhost:3002
# BOOKING_SERVICE_URL=http://localhost:3000
NOTIFICATIONS_TIMEOUT_MS=3000
PAYMENTS_TIMEOUT_MS=3000
BOOKING_TIMEOUT_MS=3000

# ---------------------------------------------------------------------------------------------
# Area D: retry policy for the monolith -> payments seam
# ---------------------------------------------------------------------------------------------
# Three attempts, exponential backoff with full jitter:
# delay = random() * min(PAYMENTS_RETRY_MAX_MS, PAYMENTS_RETRY_BASE_MS * 2^(attempt-1)).
# Every logical write carries one Idempotency-Key, so retries are safe.
PAYMENTS_MAX_ATTEMPTS=3
PAYMENTS_RETRY_BASE_MS=250
PAYMENTS_RETRY_MAX_MS=4000

# ---------------------------------------------------------------------------------------------
# Area E: OpenTelemetry and the local observability stack
# ---------------------------------------------------------------------------------------------
# Unset to disable tracing (the node:test suite does this implicitly).
# Compose sets this to http://jaeger:4318 for the containers, so it stays commented out here: a
# `.env` file is also read by `npm run dev`, where the service name `jaeger` does not resolve. For
# local dev with tracing, uncomment and use http://localhost:4318.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Jaeger UI: http://localhost:16686, Prometheus: http://localhost:9090, Grafana: http://localhost:3005

# ---------------------------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------------------------
LOG_LEVEL=info
BCRYPT_ROUNDS=10

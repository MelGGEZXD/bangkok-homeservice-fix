# Copy to .env for local/compose runs and replace these demo values.
# Area B: Keycloak issues every production token. The monolith and both extracted services
# (notifications, payments) verify those tokens against the realm JWKS; they do not share a signing
# secret. JWT_SECRET only remains for the node:test suite / local dev without Keycloak, where
# KEYCLOAK_URL is unset.
JWT_SECRET=change-me-to-a-long-random-string
INTERNAL_API_KEY=change-me-to-a-long-random-string

# Keycloak (the realm import in keycloak/realm-edemand.json creates the demo users and clients).
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Point this at a published hostname in any non-local deployment. Tokens carry this issuer.
KEYCLOAK_ISSUER=http://localhost:8081/realms/edemand
KEYCLOAK_AUDIENCE=edemand-api

# Notifications service PostgreSQL (used by compose; values shown are the demo defaults)
POSTGRES_USER=user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=notifications_db

# Area A, second extraction: Payments & Wallet PostgreSQL. Deliberately a different database from
# notifications: each service owns its own schema, and one never reads the other's tables.
PAYMENTS_DB=payments_db

# Shared secret the mock payment gateway signs callbacks with. The payments service checks it.
WEBHOOK_SECRET=edemand-webhook-secret

# Area C: RabbitMQ. Compose uses these to create the broker user and to build RABBITMQ_URL for the
# monolith and the notifications service. The exchange/queues are asserted on boot.
RABBITMQ_USER=edemand
RABBITMQ_PASSWORD=change-me
RABBITMQ_EXCHANGE=edemand.events
NOTIFICATIONS_QUEUE=edemand.notifications
SAGA_QUEUE=edemand.sagas

# Area D: retry policy for the monolith -> payments seam. Three attempts, exponential backoff with
# full jitter (delay is uniform in [0, min(cap, base * 2^(attempt-1))]). Every write carries one
# Idempotency-Key for the whole logical operation, so retries are safe.
PAYMENTS_MAX_ATTEMPTS=3
PAYMENTS_RETRY_BASE_MS=250
PAYMENTS_RETRY_MAX_MS=4000

# Area E: OpenTelemetry export and the local stack. Unset OTEL_EXPORTER_OTLP_ENDPOINT to disable
# tracing (the node:test suite does this implicitly). Jaeger UI: http://localhost:16686,
# Prometheus: http://localhost:9090, Grafana: http://localhost:3005.
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
